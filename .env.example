# ─────────────────────────────────────────────────────────────────────────────
# Supabase  (supabase.com → your project → Settings → API)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # anon/public JWT — safe to expose
SUPABASE_SERVICE_ROLE_KEY=            # service-role JWT — SERVER ONLY, never expose to browser

# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://deployguard.io
NEXT_PUBLIC_DOGFORCE_ADMIN_UID=       # Supabase auth user ID of the admin account
